    {
      "name": "Expenses",
      "item": [
        {
          "name": "Create Expense",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100.50,\n  \"date\": \"2025-05-01\",\n  \"notes\": \"Lunch with friends\",\n  \"category\": \"Food\",\n  \"tags\": [\"dining\", \"friends\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/expenses",
              "host": ["{{baseUrl}}"],
              "path": ["expenses"]
            },
            "description": "Create a new expense. Requires JWT."
          },
          "response": []
        },
        {
          "name": "Get Expenses",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/expenses?startDate=2025-05-01&endDate=2025-05-31&category=Food",
              "host": ["{{baseUrl}}"],
              "path": ["expenses"],
              "query": [
                {
                  "key": "startDate",
                  "value": "2025-05-01"
                },
                {
                  "key": "endDate",
                  "value": "2025-05-31"
                },
                {
                  "key": "category",
                  "value": "Food"
                }
              ]
            },
            "description": "List expenses with optional filters. Requires JWT."
          },
          "response": []
        },
        {
          "name": "Update Expense",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 150.75,\n  \"notes\": \"Updated lunch expense\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/expenses/:id",
              "host": ["{{baseUrl}}"],
              "path": ["expenses", ":id"]
            },
            "description": "Update an expense by ID. Replace :id with expense ID. Requires JWT."
          },
          "response": []
        },
        {
          "name": "Delete Expense",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/expenses/:id",
              "host": ["{{baseUrl}}"],
              "path": ["expenses", ":id"]
            },
            "description": "Soft delete an expense by ID. Replace :id with expense ID. Requires JWT."
          },
          "response": []
        }
      ]
    },
